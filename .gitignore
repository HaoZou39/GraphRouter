# Data directories (generated routes and preprocessed data)
data/test/
data/train/
data/val/
cache/

# Preprocessed data files (generated by preprocess.py)
data/graph_data/*/trajectories/*.df
data/graph_data/*/raw_data/test/
data/graph_data/*/raw_data/train/
data/graph_data/*/raw_data/val/
# Replay buffer files (generated by replay_buffer.py)
data/graph_data/*/trajectories/replay_buffer.df
data/graph_data/*/trajectories/data_statis.df

# Python cache files
src/__pycache__/
src/utils/__pycache__/

# Development/test files (not for production)
src/integration_test_v2.py
src/Test.ipynb
src/replay_buffer_v2.py

# Legacy V1 files (kept for reference)
src/preprocess.py
src/replay_buffer.py

# OS generated files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Temporary files
*.tmp
*.bak

